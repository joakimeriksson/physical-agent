# ============================================================
# Hackathon Infrastructure Config
# Copy to .env and fill in values:  cp .env.example .env
# ============================================================

# --- API Keys ---
OLLAMA_API_KEY=changeme
DIRIGERA_API_KEY=                        # printed on first run of dirigeramcp.py --auth

# --- Dirigera MCP Server ---
DIRIGERA_MCP_DIR=/path/to/mcp-agents/dirigera/fastmcp
DIRIGERA_MCP_HOST=127.0.0.1
DIRIGERA_MCP_PORT=8000

# --- Ollama ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=4                    # concurrent requests per model
OLLAMA_MAX_LOADED_MODELS=3               # models kept in VRAM simultaneously
OLLAMA_KEEP_ALIVE=60m                    # how long idle models stay loaded
OLLAMA_MODELS="qwen3:4b gemma3:latest qwen3:14b"  # models to pre-pull

# --- Ollama Auth Proxy ---
OLLAMA_PROXY_HOST=127.0.0.1
OLLAMA_PROXY_PORT=11435

# --- Cloudflare Tunnel ---
CLOUDFLARED_BIN=/usr/local/bin/cloudflared
CLOUDFLARED_TUNNEL_NAME=dirigera-mcp

# --- Public Hostnames (for verification/display) ---
OLLAMA_PUBLIC_URL=https://ollama.botbox.se
DIRIGERA_PUBLIC_URL=https://dirigera.botbox.se
